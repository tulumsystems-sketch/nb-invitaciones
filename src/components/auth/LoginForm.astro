---
const errorMessage = Astro.url.searchParams.get('error');
---

<div class="max-w-md mx-auto mt-12 bg-white p-8 rounded-2xl border border-stone-200 shadow-sm">
  <h1 class="text-2xl font-bold tracking-tight text-stone-900 mb-2">
    Iniciar sesión
  </h1>
  <p class="text-sm text-stone-600 mb-6">
    Accede a tus invitaciones digitales.
  </p>

  {errorMessage && (
    <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
      {errorMessage}
    </div>
  )}

  <form method="POST" action="/api/auth/signin" class="space-y-4">
    <div>
      <label class="block text-xs font-medium text-stone-700 mb-1" for="email">
        Correo electrónico
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-3 py-2 rounded-lg border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
        placeholder="tu@correo.com"
      />
    </div>

    <div>
      <label
        class="block text-xs font-medium text-stone-700 mb-1"
        for="password"
      >
        Contraseña
      </label>
      <input
        type="password"
        id="password"
        name="password"
        required
        class="w-full px-3 py-2 rounded-lg border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900"
        placeholder="••••••••"
      />
    </div>

    <button
      type="submit"
      class="w-full py-2.5 px-4 rounded-lg bg-stone-900 text-white font-medium text-sm hover:bg-stone-800 transition-colors cursor-pointer"
    >
      Entrar
    </button>
  </form>

  <p class="mt-6 text-center text-xs text-stone-500">
    ¿No tenés una cuenta?
    <a href="/registro" class="text-stone-900 font-medium underline">
      Registrate acá
    </a>
  </p>
</div>
