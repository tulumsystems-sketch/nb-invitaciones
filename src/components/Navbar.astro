---
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { user, isAnonymous } = Astro.locals;
const pathname = Astro.url.pathname;

const isCrear = pathname.startsWith('/crear');
const isMisInv = pathname.startsWith('/mis-invitaciones');
---

<header
  class={`sticky top-0 z-40 w-full transition-colors duration-300 ${
    overlay
      ? 'border-b border-white/15 bg-stone-950/45 text-white backdrop-blur-md'
      : 'border-b border-stone-200/80 bg-[#f7f5f0]/90 text-stone-900 backdrop-blur-md'
  }`}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 sm:py-3">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-3 transition hover:opacity-90"
    >
      <img
        src="/Logo_Principal.jpg"
        alt="Logo NB Invitaciones"
        width="44"
        height="44"
        style="width: 44px; height: 44px; min-width: 44px; max-width: 44px; object-fit: cover;"
        class={`shrink-0 rounded-full shadow-xs transition ${
          overlay
            ? 'ring-2 ring-white/35 group-hover:ring-white/65'
            : 'ring-1 ring-stone-300 group-hover:ring-stone-400'
        }`}
      />
      <span class="text-sm font-bold tracking-tight sm:text-base">NB Invitaciones</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-1.5">
      <a
        href="/crear"
        class={`rounded-full px-3.5 py-1.5 text-xs font-semibold transition ${
          isCrear
            ? overlay
              ? 'bg-white text-stone-950 shadow-2xs'
              : 'bg-stone-900 text-white'
            : overlay
              ? 'text-stone-100/90 hover:bg-white/12 hover:text-white'
              : 'text-stone-700 hover:bg-stone-200/70'
        }`}
      >
        Crear
      </a>

      <a
        href="/mis-invitaciones"
        class={`rounded-full px-3.5 py-1.5 text-xs font-semibold transition ${
          isMisInv
            ? overlay
              ? 'bg-white text-stone-950 shadow-2xs'
              : 'bg-stone-900 text-white'
            : overlay
              ? 'text-stone-100/90 hover:bg-white/12 hover:text-white'
              : 'text-stone-700 hover:bg-stone-200/70'
        }`}
      >
        Mis invitaciones
      </a>

      {user && !isAnonymous ? (
        <span
          title={user.email || ''}
          class={`hidden max-w-44 truncate rounded-full px-3 py-1 text-[11px] font-medium sm:inline-block ${
            overlay
              ? 'border border-white/15 bg-stone-950/50 text-stone-200'
              : 'border border-emerald-200 bg-emerald-50 text-emerald-800'
          }`}
        >
          {user.email}
        </span>
      ) : (
        <a
          href="/login"
          class={`rounded-full px-3.5 py-1.5 text-xs font-semibold transition ${
            overlay
              ? 'border border-white/25 bg-white/10 text-white hover:bg-white/20'
              : 'border border-stone-300 bg-white text-stone-800 hover:bg-stone-50'
          }`}
        >
          Ingresar
        </a>
      )}
    </nav>
  </div>
</header>