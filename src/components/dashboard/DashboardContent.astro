---
// Recibimos el email del usuario por props para saludarlo de forma personalizada
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div class="space-y-6">
  <!-- Cabecera de la sección -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200 pb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-stone-900">
        Mis Invitaciones
      </h1>
      <p class="text-sm text-stone-600 mt-1">
        Gestioná los eventos que creaste para{' '}
        <span class="font-medium text-stone-900">{email}</span>.
      </p>
    </div>

    <a
      href="/plantillas"
      class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-stone-900 text-white text-sm font-medium hover:bg-stone-800 transition-colors"
    >
      + Crear nueva invitación
    </a>
  </div>

  <!-- Estado vacío (Placeholder para cuando aún no hay invitaciones creadas) -->
  <div class="text-center py-16 bg-white rounded-2xl border border-stone-200 p-8">
    <div class="max-w-sm mx-auto space-y-3">
      <div class="w-12 h-12 rounded-full bg-stone-100 flex items-center justify-center mx-auto text-stone-500">
        🎉
      </div>
      <h3 class="text-base font-semibold text-stone-900">
        Todavía no tenés invitaciones
      </h3>
      <p class="text-xs text-stone-500">
        Elegí una plantilla profesional, completá los datos del evento y
        compartí el enlace con tus invitados en minutos.
      </p>
      <div class="pt-2">
        <a
          href="/plantillas"
          class="inline-block px-4 py-2 rounded-lg bg-stone-100 text-stone-900 text-xs font-medium hover:bg-stone-200 transition-colors"
        >
          Ver plantillas disponibles
        </a>
      </div>
    </div>
  </div>
</div>
