---
import BaseLayout from '../layouts/BaseLayout.astro';

const { user, isAnonymous } = Astro.locals;
const errorMessage = Astro.url.searchParams.get('error');

if (user && !isAnonymous) {
  return Astro.redirect('/mis-invitaciones');
}
---

<BaseLayout title="Iniciar sesión — NB Invitaciones">
  <section class="mx-auto max-w-md px-4 py-14 sm:px-6">
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-stone-500">
        Acceso clientes
      </span>

      <h1 class="mt-1 text-2xl font-bold tracking-tight text-stone-900">
        Iniciar sesión
      </h1>

      <p class="mt-2 text-sm text-stone-600">
        Accedé a tus invitaciones guardadas, confirmaciones y estado de publicación.
      </p>

      {errorMessage && (
        <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-xs font-medium text-red-700">
          {errorMessage}
        </div>
      )}

      <form method="POST" action="/api/auth/signin" class="mt-6 space-y-4">
        <div>
          <label for="email" class="block text-xs font-medium text-stone-700">
            Correo electrónico
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tu@correo.com"
            class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm text-stone-900 focus:border-stone-900 focus:outline-none"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-medium text-stone-700">
            Contraseña
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 text-sm text-stone-900 focus:border-stone-900 focus:outline-none"
          />
        </div>

        <button
          type="submit"
          class="w-full cursor-pointer rounded-xl bg-stone-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-stone-800"
        >
          Entrar
        </button>
      </form>

      <div class="mt-6 flex items-center justify-between border-t border-stone-100 pt-4 text-xs text-stone-600">
        <a href="/crear" class="font-medium text-stone-700 underline">
          Empezar sin cuenta
        </a>
        <a href="/registro" class="font-semibold text-stone-900 underline">
          Crear cuenta
        </a>
      </div>
    </div>
  </section>
</BaseLayout>